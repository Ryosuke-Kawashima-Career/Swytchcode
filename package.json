{
  "name": "community-organizer-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Community Organizer Agent (Hackathon Track 3) - Discord + Swytchcode (Notion, X, Resend)",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:setup": "node --test tests/setup.test.ts",
    "test:monitor": "node --test tests/monitor.test.ts",
    "test:discord": "node --test tests/discord.test.ts",
    "test:agents": "node --test tests/agents.test.ts",
    "test:flow": "node --test tests/agent_flow.test.ts",
    "test:demo": "node --test tests/demo.test.ts",
    "typecheck": "tsc",
    "demo:simulate": "node --env-file-if-exists=.env src/demo/simulate.ts",
    "dev": "node --env-file-if-exists=.env --watch src/demo/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}

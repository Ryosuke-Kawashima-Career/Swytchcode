# Copy to .env and fill in. Leave DEMO_MODE=mock to run the demo with no credentials.
DEMO_MODE=mock
PORT=3000

# Swytchcode service token (CLI/runtime). Provider auth is managed via `swy auth connect <provider>`.
SWYTCHCODE_TOKEN=

# Notion (tools: notion.page.create, notion.query.create)
# Sponsor CRM data source: needs title, Email (email) and Company (text) properties.
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2025-09-03
NOTION_SPONSOR_DATA_SOURCE_ID=

# Resend (tool: resend.email.create)
RESEND_FROM_EMAIL=
SPONSOR_REPORT_EMAIL=

# Discord (bot for gateway/polls, webhook as fallback dispatcher)
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_GENERAL_ID=
DISCORD_CHANNEL_EVENTS_ID=
